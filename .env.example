# --- Mage-OS / Magento connection ---

# Base URL of the store (no trailing /graphql). Example: https://app.mage-os.test
MAGENTO_BASE_URL=https://app.mage-os.test

# Optional: store view code sent as the `Store` header (defaults to "default").
MAGENTO_STORE_CODE=default

# Set to "true" to accept self-signed TLS certs (typical for local Warden/Docker).
# NEVER enable this against a production store.
MAGENTO_INSECURE_TLS=true

# Optional request timeout in milliseconds (default 15000).
MAGENTO_TIMEOUT_MS=15000
